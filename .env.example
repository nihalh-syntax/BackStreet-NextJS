# Neon Postgres — create a project at https://neon.tech and paste the connection string
# Prisma CLI scripts load this from `.env.local` (see package.json db:* scripts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk (Phase 3+)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe (checkout Server Actions)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — legacy checkout URL until Server Actions land
NEXT_PUBLIC_CHECKOUT_API_URL=
