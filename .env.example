# Local development — copy to `.env.local`
# Vercel production — add the same keys in Project Settings → Environment Variables

# Neon Postgres (https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=

# App URL — use your Vercel domain in production (no trailing slash)
# e.g. https://back-street.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local-only fallback (next.config maps this to Clerk publishable key)
# VITE_CLERK_PUBLISHABLE_KEY=

# ─── Vercel deploy checklist ───
# 1. Import repo at vercel.com → root directory: Back-Street (or repo root if standalone)
# 2. Set all env vars above for Production
# 3. Deploy — vercel-build runs migrate deploy + seed + next build
# 4. Clerk Dashboard → Webhooks → https://YOUR_DOMAIN/api/webhooks/clerk
#    Events: user.created, user.updated, user.deleted
# 5. Clerk Dashboard → Domains → add your Vercel URL
# 6. Stripe Dashboard → use live/test keys matching your Clerk environment
